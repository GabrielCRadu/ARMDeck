#!/bin/sh
# op8-thermal (armdeck): thermal protection by battery temperature.
# The kernel only protects the processor (throttling at 90 and 95 C, shutdown at 110 C). Android
# throttles by case and battery temperature, much earlier; that was missing here, and a 3D game
# took the battery to 46.5 C (2026-10-02). The phone has no case sensor; the battery (the bq27411
# gauge) is the closest to the hand and the part that suffers most from heat.
#
# In levels, with hysteresis: it goes up at once to the level reached and comes down one level
# at a time, only once the battery drops HYST below the current level's threshold. The limits are
# maximum frequencies; the kernel still picks the real frequency below them. In standby
# (op8-standby) nothing is touched: op8-standby then keeps the big cores at their minimum and
# restores them itself; after waking up the limit is applied again.
# Log: journalctl -t op8-thermal (and the frequency columns of op8-sampler).
# "op8-thermal restore" removes every limit (when the service stops).
BAT=/sys/class/power_supply/bq27411-0/temp
CF=/sys/devices/system/cpu/cpufreq
GPU=/sys/class/devfreq/3d00000.gpu
STANDBY=/run/op8-standby.active
STATE=/run/op8-thermal.level
PERIOD=5
HYST=10

log() { logger -t op8-thermal -- "$*"; }

# the entry threshold of a level, in tenths of a degree
enter() {
	case "$1" in
		1) echo 410 ;;
		2) echo 420 ;;
		3) echo 430 ;;
		4) echo 445 ;;
	esac
}

# the limits of a level: big cores (policy4, kHz), the prime core (policy7, kHz), GPU (Hz);
# "max" = no limit. The little cores (policy0) are not limited.
caps() {
	case "$1" in
		0) echo "max max max" ;;
		1) echo "2054400 2457600 max" ;;
		2) echo "1766400 2073600 525000000" ;;
		3) echo "1478400 1632000 441600000" ;;
		4) echo "1056000 1190400 305000000" ;;
	esac
}

# writes a limit only if it differs from the current one
set_max() {
	f=$1
	v=$2
	[ "$(cat "$f")" = "$v" ] || echo "$v" > "$f"
}

apply() {
	set -- $(caps "$1")
	b=$1
	p=$2
	g=$3
	[ "$b" = max ] && b=$(cat "$CF/policy4/cpuinfo_max_freq")
	[ "$p" = max ] && p=$(cat "$CF/policy7/cpuinfo_max_freq")
	[ "$g" = max ] && g=$(tr ' ' '\n' < "$GPU/available_frequencies" | sort -n | tail -1)
	set_max "$CF/policy4/scaling_max_freq" "$b"
	set_max "$CF/policy7/scaling_max_freq" "$p"
	set_max "$GPU/max_freq" "$g"
}

if [ "${1:-}" = restore ]; then
	apply 0
	rm -f "$STATE"
	log "limits removed"
	exit 0
fi

level=0
echo 0 > "$STATE"
log "started: battery thresholds 41/42/43/44.5 C, hysteresis $((HYST / 10)) C"
while :; do
	if ! t=$(cat "$BAT" 2>/dev/null) || [ -z "$t" ]; then
		sleep "$PERIOD"
		continue
	fi
	new=$level
	# going up: the highest level whose threshold is reached
	for l in 4 3 2 1; do
		if [ "$t" -ge "$(enter "$l")" ]; then
			[ "$l" -gt "$new" ] && new=$l
			break
		fi
	done
	# going down: one level at a time, below the current level's threshold minus HYST
	if [ "$new" = "$level" ] && [ "$level" -gt 0 ] && [ "$t" -lt $(( $(enter "$level") - HYST )) ]; then
		new=$((level - 1))
	fi
	if [ "$new" != "$level" ]; then
		log "battery $((t / 10)).$((t % 10)) C: level $level -> $new ($(caps "$new"))"
		level=$new
		echo "$level" > "$STATE"
	fi
	[ -e "$STANDBY" ] || apply "$level"
	sleep "$PERIOD"
done
