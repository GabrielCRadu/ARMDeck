[Unit]
Description=op8-thermal: thermal protection by battery temperature (limits the big CPU cores and the GPU)
After=local-fs.target op8-tune.service

[Service]
Type=simple
ExecStart=/usr/local/bin/op8-thermal
ExecStopPost=/usr/local/bin/op8-thermal restore
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
