#!/bin/sh
# op8-lowbatt (armdeck): a clean power-off when the battery is really empty.
# Nothing turned the phone off on a low battery: twice (2026-10-06 and 2026-10-12) it sat in the
# Steam interface at the gauge's 0% until the battery itself cut out at 2.65 V, 20-25 minutes
# below 3.25 V each time (op8-sampler logs; the second log ends in NUL bytes, the file system
# lost its last writes). A deep discharge like that wears a Li-ion cell, and a power cut can
# corrupt files.
# The rule is OnePlus' for this phone (LineageOS android_kernel_oneplus_sm8250,
# drivers/power/oplus/oplus_charger.c, DT vendor/19821/kona-mtp.dtsi qcom,vbatt_power_off = 3250):
# the gauge's 0% alone never turns the phone off while the battery is above 3.25 V; once it stays
# below 3.25 V the shown level runs down 1% every 15 s and the phone powers off at 0. Here: off
# when the voltage stays below 3.25 V for 15 s while the battery is discharging. Short dips under
# a heavy load (down to 2.95 V for one sample at 2.4 A, 2026-10-06) last a few seconds and do not
# count; a charger that keeps up (current >= 0) stops the count.
# Log: journalctl -t op8-lowbatt.
B=/sys/class/power_supply/bq27411-0
OFF_MV=3250
HOLD=15
# slow polling while the battery is far from empty, fast near the threshold
WATCH_MV=3400
SLOW=10
FAST=2

log() { logger -t op8-lowbatt -- "$*"; }
# A standby (op8-standby) keeps the user's apps frozen with cgroup.freeze, which systemd does not
# know about: a shutdown would then wait for every frozen unit's stop timeout, minutes of a draining
# battery below 3.25 V. End the standby first (its restore thaws the apps), and thaw them here as
# well in case that did not work. A signal, not "systemctl stop": logind's suspend job cannot be
# replaced by a stop job ("transaction is destructive", tested 2026-10-29); op8-standby ends on
# TERM and restores.
end_standby() {
	[ -e /run/op8-standby.active ] || return 0
	log "standby active: ending it before the power-off"
	systemctl kill -s TERM systemd-suspend.service
	n=0
	while [ -e /run/op8-standby.active ] && [ $n -lt 15 ]; do
		sleep 1
		n=$((n + 1))
	done
	[ -e /run/op8-standby.active ] && log "standby still marked active after $n s"
	u=/sys/fs/cgroup/user.slice/user-10000.slice/user@10000.service
	for c in "$u/app.slice" "$u/user.slice"; do
		[ -w "$c/cgroup.freeze" ] && echo 0 > "$c/cgroup.freeze"
	done
}

log "started: power-off below $OFF_MV mV for $HOLD s while discharging"
below=0
blind=0
while :; do
	v=$(cat "$B/voltage_now" 2>/dev/null)
	i=$(cat "$B/current_now" 2>/dev/null)
	if [ -z "$v" ] || [ -z "$i" ]; then
		# without the gauge nothing protects the battery: 10 minutes blind is a fault, not a glitch,
		# and a clean power-off is better than running the battery down unseen
		[ "$blind" = 0 ] && log "battery gauge unreadable"
		blind=$((blind + SLOW))
		if [ "$blind" -ge 600 ]; then
			log "battery gauge unreadable for $blind s: powering off"
			end_standby
			systemctl poweroff
			exit 0
		fi
		below=0
		sleep "$SLOW"
		continue
	fi
	[ "$blind" -gt 0 ] && log "battery gauge readable again after $blind s"
	blind=0
	mv=$((v / 1000))
	ma=$((i / 1000))
	if [ "$mv" -lt "$OFF_MV" ] && [ "$ma" -lt 0 ]; then
		[ "$below" = 0 ] && log "battery $mv mV at $ma mA: below $OFF_MV mV, powering off if it stays there for $HOLD s"
		below=$((below + FAST))
		if [ "$below" -ge "$HOLD" ]; then
			log "battery $mv mV at $ma mA for $below s: powering off"
			end_standby
			systemctl poweroff
			# Only for a poweroff request that never starts: once the shutdown starts, systemd
			# stops this service too, and the safety net is the 3 minute job timeout of
			# poweroff.target (armdeck-poweroff-timeout.conf, then a forced power-off).
			sleep 60
			log "shutdown still not done: forcing it"
			systemctl poweroff --force
			exit 0
		fi
		sleep "$FAST"
		continue
	fi
	[ "$below" -gt 0 ] && log "battery back to $mv mV at $ma mA after $below s: no power-off"
	below=0
	if [ "$mv" -lt "$WATCH_MV" ]; then
		sleep "$FAST"
	else
		sleep "$SLOW"
	fi
done
