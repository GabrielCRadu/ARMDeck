#!/bin/sh
# op8-log (armdeck): marks a moment in the log, for example: op8-mark download start
# It appears in the systemd journal (op8-mark) and in the "mark" column of the next sample.
m="$*"
[ -n "$m" ] || { echo "usage: op8-mark <text>"; exit 2; }
logger -t op8-mark -- "$m"
printf '%s\n' "$m" > /run/op8/mark
echo "marked: $m"
