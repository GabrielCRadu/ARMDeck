#!/bin/sh
# op8-log (steamed-noodle): marcheaza un moment in log, de exemplu: op8-mark start descarcare
# Apare in jurnalul systemd (op8-mark) si in coloana "mark" a urmatorului esantion.
m="$*"
[ -n "$m" ] || { echo "folosire: op8-mark <text>"; exit 2; }
logger -t op8-mark -- "$m"
printf '%s\n' "$m" > /run/op8/mark
echo "marcat: $m"
