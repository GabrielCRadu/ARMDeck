[Unit]
Description=op8-log: the processes using the most CPU every ~2 s (debugging only)

[Service]
# above 20 MB the old log becomes op8-top.log.prev
ExecStartPre=/bin/sh -c 'f=/home/gabriel/op8-top.log; [ -f "$f" ] && [ $(wc -c < "$f") -gt 20000000 ] && mv -f "$f" "$f.prev"; true'
ExecStart=/home/gabriel/op8-top /home/gabriel/op8-top.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
