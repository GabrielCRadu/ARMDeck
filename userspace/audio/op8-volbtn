#!/bin/sh
# op8-volbtn (steamed-noodle): butoanele de volum ale telefonului controleaza volumul iesirii
# implicite ("Difuzoare (protejat)"): +/-5% pe apasare si la tinut apasat (repetare), cu limita
# 100%. Plafonul fizic ramane volumul iesirii directe (-30 dB), pe care butoanele nu-l ating.
# In standby (op8-standby) butoanele se ignora. Jurnal: journalctl -t op8-volbtn
log() { logger -t op8-volbtn -- "$*"; }

dev() {
	for e in /sys/class/input/event*; do
		[ "$(cat "$e/device/name" 2>/dev/null)" = "$1" ] && echo "/dev/input/$(basename "$e")"
	done
}

# citeste evenimentele unui dispozitiv; KEY_VOLUMEDOWN = 114, KEY_VOLUMEUP = 115,
# valoare 1 = apasat, 2 = repetare automata
watch() {
	ev=$1
	t=${XDG_RUNTIME_DIR:-/tmp}/op8-volbtn-$(basename "$ev")
	while :; do
		dd if="$ev" bs=24 count=1 of="$t" 2>/dev/null || { sleep 1; continue; }
		set -- $(od -An -tu2 -j16 -N4 "$t") 0 0
		[ "$1" = 1 ] || continue
		code=$2
		val=$(od -An -td4 -j20 -N4 "$t" | tr -d ' ')
		[ "$val" = 1 ] || [ "$val" = 2 ] || continue
		[ -e /run/op8-standby.active ] && continue
		case "$code" in
			115) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
			114) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
			*) continue ;;
		esac
		[ "$val" = 1 ] && log "cod $code -> $(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
	done
}

started=0
for name in gpio-keys pm8941_resin; do
	ev=$(dev "$name")
	if [ -n "$ev" ]; then
		log "citesc $name ($ev)"
		watch "$ev" &
		started=$((started + 1))
	else
		log "nu gasesc $name"
	fi
done
[ "$started" -gt 0 ] || exit 1
wait
