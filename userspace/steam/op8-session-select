#!/bin/sh
# armdeck: steamos-session-select in the Steam container (/usr/local/bin/steamos-session-select).
# On "Switch to Desktop", without the SteamOSManager service, Steam runs `steamos-session-select
# plasma` (the "legacy" path in steamui.so) and waits for the session to stop it. Without this
# command the interface stayed frozen. ARMDeck has no desktop: Steam exits, and steam-gs.service
# (Restart=always) starts it again in Game Mode. Log: ~/op8-session-select.log
L="$HOME/op8-session-select.log"
STEAM="$HOME/.local/share/Steam"
CLIENT_DIR="$STEAM/steamrtarm64"
echo "$(date '+%F %T') steamos-session-select $*: no desktop, Steam exits and starts again" >> "$L"
# Steam waits for the command to finish (system()), so the shutdown is requested in the background
(
	sleep 1
	cd "$CLIENT_DIR" &&
	LD_LIBRARY_PATH="$CLIENT_DIR:$STEAM/lib/aarch64-linux-gnu" ./steam -shutdown >> "$L" 2>&1
	echo "$(date '+%F %T') steam -shutdown: exit code $?" >> "$L"
) </dev/null >/dev/null 2>&1 &
exit 0
