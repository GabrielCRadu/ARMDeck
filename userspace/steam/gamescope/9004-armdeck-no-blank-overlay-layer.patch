 gamescope::ConVar<bool> cv_paint_steam_overlay_plane{ "paint_steam_overlay_plane", true };
+// armdeck: on a session backend, while the Steam overlay is hidden, gamescope composites a blank
+// full-screen layer in its place, so the first frame of the overlay does not stutter. Where every
+// frame is composited on the GPU anyway (the OnePlus 8 panel is rotated and SM8250 planes cannot
+// rotate 90 degrees), that layer is one more texture read and blend per output pixel on every
+// frame. ARMDECK_NO_BLANK_OVERLAY=1 makes the default off; gamescopectl can switch it at runtime.
+gamescope::ConVar<bool> cv_paint_blank_overlay_plane{ "paint_blank_overlay_plane", !getenv( "ARMDECK_NO_BLANK_OVERLAY" ), "Composite a blank layer in place of the hidden Steam overlay, so showing the overlay does not stutter. Costs one more layer on every frame." };
 gamescope::ConVar<bool> cv_paint_external_overlay_plane{ "paint_external_overlay_plane", true };
 gamescope::ConVar<bool> cv_paint_cursor_plane{ "paint_cursor_plane", true };
