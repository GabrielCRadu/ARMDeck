#!/bin/sh
# op8-touchmode (armdeck): touch like on a Steam Deck, with or without a controller.
# gamescope's touch mode is the STEAM_TOUCH_CLICK_MODE atom on the Xwayland root window. Steam sets
# it only from Steam Input, so only while a controller is connected, and then it may pick mode 1
# (touch = mouse click, with a cursor) even in the Steam interface. Here we follow the focused app
# (GAMESCOPE_FOCUSED_APP) and the mode itself: Steam's interface (769) or nothing = 4 (real touch:
# swipe = scroll, no cursor), any game = 1 (tap = left click). If anything else changes the mode,
# it is set back, and the correction is logged.
# Started by steam-in-container.sh, in the container, with gamescope's DISPLAY.
# Log: ~/op8-touchmode.log
L="$HOME/op8-touchmode.log"
P="${XDG_RUNTIME_DIR:-/tmp}/op8-touchmode.pid"
# a single instance: stop the old one (left over from an earlier Steam session), including its
# children (the xprop pipeline), which otherwise keep running on their own
old=$(cat "$P" 2>/dev/null)
if [ -n "$old" ]; then
	pkill -P "$old" 2>/dev/null
	kill "$old" 2>/dev/null
fi
echo $$ > "$P"

set_mode() {
	xprop -root -f STEAM_TOUCH_CLICK_MODE 32c -set STEAM_TOUCH_CLICK_MODE "$1" 2>> "$L"
	echo "$(date '+%F %T') $2 -> touch mode $1" >> "$L"
}

# wait for Xwayland (up to 60 s)
for i in $(seq 1 60); do xprop -root >/dev/null 2>&1 && break; sleep 1; done
echo "$(date '+%F %T') started on DISPLAY=$DISPLAY" >> "$L"
set_mode 4 "start"

app=0
want=4
xprop -root -spy GAMESCOPE_FOCUSED_APP STEAM_TOUCH_CLICK_MODE 2>> "$L" | while read -r line; do
	val=${line##*= }
	case "$val" in *[!0-9]*|'') val=0 ;; esac
	case "$line" in
		GAMESCOPE_FOCUSED_APP*)
			app=$val
			if [ "$app" = 769 ] || [ "$app" = 0 ]; then new=4; else new=1; fi
			[ "$new" = "$want" ] && continue
			want=$new
			set_mode "$want" "app $app"
			;;
		STEAM_TOUCH_CLICK_MODE*)
			# our own write comes back here with the wanted value and is ignored
			[ "$val" = "$want" ] && continue
			set_mode "$want" "mode changed to $val by someone else (app $app)"
			;;
	esac
done
