#!/bin/sh
# op8-standby (armdeck, OnePlus 8): a safe "sleep" WITHOUT kernel suspend (s2idle is not tested
# on our kernel; if it does not wake up, only a forced reset is left).
# Steam -> dbus-send login1 Suspend -> systemd-suspend.service -> this script (instead of
# systemd-sleep). Black screen, the user's apps frozen, the big cores at their minimum frequency;
# waits for the power button, then restores everything. Steam sees a normal sleep/wake cycle.
# Modeled on konkr-standby from SteamOS-ARM-Handhelds.
# Log: journalctl -t op8-standby. Markers for op8-powerbtn: /run/op8-standby.active
# (while it runs) and /run/op8-standby.resumed (the moment it ends).
U=/sys/fs/cgroup/user.slice/user-10000.slice/user@10000.service
CF=/sys/devices/system/cpu/cpufreq
BL=$(ls -d /sys/class/backlight/* 2>/dev/null | head -1)
EV=
for e in /sys/class/input/event*; do
	[ "$(cat "$e/device/name" 2>/dev/null)" = pm8941_pwrkey ] && EV=/dev/input/$(basename "$e")
done
log() { logger -t op8-standby -- "$*"; }

touch /run/op8-standby.active
old_bl=$(cat "$BL/brightness" 2>/dev/null)
log "entering standby: brightness $old_bl, button $EV, uptime $(cut -d' ' -f1 /proc/uptime)"

restore() {
	trap - EXIT INT TERM
	for p in policy4 policy7; do
		[ -s "/run/op8-standby-$p" ] && cat "/run/op8-standby-$p" > "$CF/$p/scaling_max_freq"
	done
	for c in "$U/app.slice" "$U/user.slice"; do
		[ -w "$c/cgroup.freeze" ] && echo 0 > "$c/cgroup.freeze"
	done
	[ -n "$old_bl" ] && echo "$old_bl" > "$BL/brightness"
	rm -f /run/op8-standby.active
	touch /run/op8-standby.resumed
	log "leaving standby: brightness $(cat "$BL/brightness"), app.slice frozen=$(cat "$U/app.slice/cgroup.freeze"), max cpu4=$(cat "$CF/policy4/scaling_max_freq") cpu7=$(cat "$CF/policy7/scaling_max_freq")"
}
trap restore EXIT INT TERM

# 1. black screen
[ -n "$BL" ] && echo 0 > "$BL/brightness"
log "step 1: brightness $(cat "$BL/brightness")"
# 2. Steam, gamescope, the game and the container frozen; PipeWire (session.slice) keeps running
for c in "$U/app.slice" "$U/user.slice"; do
	[ -w "$c/cgroup.freeze" ] && echo 1 > "$c/cgroup.freeze"
done
sleep 1
log "step 2: app.slice $(grep frozen "$U/app.slice/cgroup.events"), user.slice $(grep frozen "$U/user.slice/cgroup.events" 2>/dev/null)"
# 3. the big cores at their minimum frequency
for p in policy4 policy7; do
	cat "$CF/$p/scaling_max_freq" > "/run/op8-standby-$p"
	cat "$CF/$p/scaling_min_freq" > "$CF/$p/scaling_max_freq"
done
log "step 3: max cpu4=$(cat "$CF/policy4/scaling_max_freq") cpu7=$(cat "$CF/policy7/scaling_max_freq"); waiting for the power button"

# 4. wait for the power button: a 64-bit input_event = 24 bytes, type at byte 16 (EV_KEY = 1),
#    code at 18 (KEY_POWER = 116), value at 20 (1 = pressed).
#    Presses in the first 2 seconds are ignored (the same press that asked for sleep).
#    Fallback exit: the file /run/op8-wake (sudo touch /run/op8-wake, over SSH).
start=$(cut -d. -f1 /proc/uptime)
while :; do
	if [ -e /run/op8-wake ]; then
		rm -f /run/op8-wake
		log "woken through /run/op8-wake"
		break
	fi
	if [ -n "$EV" ]; then
		if ! dd if="$EV" bs=24 count=1 of=/run/op8-standby-ev 2>/dev/null; then
			log "read from $EV failed"
			sleep 1
			continue
		fi
		set -- $(od -An -tu2 -j16 -N4 /run/op8-standby-ev) 0 0
		val=$(od -An -td4 -j20 -N4 /run/op8-standby-ev | tr -d ' ')
		now=$(cut -d. -f1 /proc/uptime)
		[ "$1" = 1 ] && log "event type=$1 code=$2 value=$val at +$((now - start)) s"
		if [ "$1" = 1 ] && [ "$2" = 116 ] && [ "$val" = 1 ] && [ $((now - start)) -ge 2 ]; then
			log "woken by the power button"
			break
		fi
	else
		sleep 1
	fi
done
exit 0
