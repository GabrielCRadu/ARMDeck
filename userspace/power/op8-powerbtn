#!/bin/sh
# op8-powerbtn (armdeck): the power button as on a Steam Deck (steamos-powerbuttond):
# short press = steam://shortpowerpress (Steam goes to sleep), long press (>= 1 s) =
# steam://longpowerpress (the power menu). In standby, op8-standby handles the wake-up;
# the button is ignored for 3 seconds after waking, so the wake-up press does not ask for
# another sleep. Runs as a user service in background.slice (not frozen by op8-standby).
# Log: journalctl -t op8-powerbtn
EV=
for e in /sys/class/input/event*; do
	[ "$(cat "$e/device/name" 2>/dev/null)" = pm8941_pwrkey ] && EV=/dev/input/$(basename "$e")
done
log() { logger -t op8-powerbtn -- "$*"; }
[ -n "$EV" ] || { log "power button not found (pm8941_pwrkey)"; exit 1; }
T=${XDG_RUNTIME_DIR:-/tmp}/op8-powerbtn-ev
log "started, reading $EV"

steam_url() {
	podman exec --user gabriel steam sh -c "cd \$HOME/.local/share/Steam/steamrtarm64 && LD_LIBRARY_PATH=\$PWD:\$HOME/.local/share/Steam/lib/aarch64-linux-gnu ./steam -ifrunning $1" >/dev/null 2>&1 &
}

down=0
while :; do
	dd if="$EV" bs=24 count=1 of="$T" 2>/dev/null || { sleep 1; continue; }
	set -- $(od -An -tu2 -j16 -N4 "$T") 0 0
	[ "$1" = 1 ] && [ "$2" = 116 ] || continue
	val=$(od -An -td4 -j20 -N4 "$T" | tr -d ' ')
	# the event time in ms, from the kernel timestamp (tv_sec, tv_usec)
	set -- $(od -An -tu8 -N16 "$T")
	ms=$(($1 * 1000 + $2 / 1000))
	if [ "$val" = 1 ]; then
		down=$ms
		continue
	fi
	[ "$val" = 0 ] && [ "$down" -gt 0 ] || continue
	dur=$((ms - down))
	down=0
	now=$(date +%s)
	res=$(stat -c %Y /run/op8-standby.resumed 2>/dev/null || echo 0)
	if [ -e /run/op8-standby.active ]; then
		log "press of ${dur} ms ignored: standby active"
	elif [ $((now - res)) -lt 3 ]; then
		log "press of ${dur} ms ignored: woke up $((now - res)) s ago"
	elif [ "$dur" -lt 1000 ]; then
		log "short press (${dur} ms) -> steam://shortpowerpress"
		steam_url steam://shortpowerpress
	else
		log "long press (${dur} ms) -> steam://longpowerpress"
		steam_url steam://longpowerpress
	fi
done
