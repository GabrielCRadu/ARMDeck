#!/bin/sh
# op8-power-test (armdeck): measures the battery current in the sleep states, without kernel
# suspend. Each state adds something on top of the one before, lasts STAGE_S seconds, and the
# average leaves out the first SETTLE_S seconds. At the end everything is put back as it was.
# The phone must be UNPLUGGED (otherwise the charge current spoils the measurement).
# Run (keeps running after SSH drops, when WiFi is turned off):
#   sudo systemd-run --unit=op8-power-test /bin/sh /home/gabriel/op8-power-test
# Result: /var/log/op8/power-test-<date>.txt
STAGE_S=${STAGE_S:-120}
SETTLE_S=${SETTLE_S:-30}
U=/sys/fs/cgroup/user.slice/user-10000.slice/user@10000.service
CF=/sys/devices/system/cpu/cpufreq
BL=$(ls -d /sys/class/backlight/* | head -1)
BAT=/sys/class/power_supply/bq27411-0
OUT=/var/log/op8/power-test-$(date +%Y%m%d-%H%M%S).txt

out() { echo "$*" >> "$OUT"; logger -t op8-power-test -- "$*"; }
gsctl() { su -s /bin/sh gabriel -c "XDG_RUNTIME_DIR=/run/user/10000 gamescopectl $*" >/dev/null 2>&1; }

measure() {
	name=$1
	sleep "$SETTLE_S"
	n=0; sum=0; min=0; max=-999999
	end=$(( $(cut -d. -f1 /proc/uptime) + STAGE_S - SETTLE_S ))
	while [ "$(cut -d. -f1 /proc/uptime)" -lt "$end" ]; do
		i=$(( $(cat "$BAT/current_now") / 1000 ))
		n=$((n + 1)); sum=$((sum + i))
		[ "$i" -lt "$min" ] && min=$i
		[ "$i" -gt "$max" ] && max=$i
		sleep 2
	done
	out "$(printf '%-44s average %5d mA  (min %5d, max %5d, %d readings)  battery %s%% %s mV' \
		"$name" $((sum / n)) "$min" "$max" "$n" "$(cat $BAT/capacity)" $(( $(cat $BAT/voltage_now) / 1000 )))"
}

old_bl=$(cat "$BL/brightness")
for p in policy0 policy4 policy7; do eval "old_$p=$(cat $CF/$p/scaling_max_freq)"; done

restore() {
	trap - EXIT INT TERM
	rfkill unblock wlan 2>/dev/null; rfkill unblock bluetooth 2>/dev/null
	systemctl kill -s CONT op8-sampler 2>/dev/null
	# CPU frequencies first: with them at the minimum the panel does not come back (DSI errors, black screen)
	for p in policy0 policy4 policy7; do eval "v=\$old_$p"; echo "$v" > "$CF/$p/scaling_max_freq"; done
	for c in "$U/app.slice" "$U/user.slice"; do echo 0 > "$c/cgroup.freeze"; done
	sleep 1
	gsctl drm_sleep_internal_screen 0
	echo "$old_bl" > "$BL/brightness"
	rm -f /run/op8-standby.active
	out "restored: brightness $(cat $BL/brightness), wifi $(rfkill list wlan | grep -c 'Soft blocked: no') unblocked"
}
trap restore EXIT INT TERM

out "op8-power-test $(date '+%F %T'), kernel $(uname -v | cut -c1-40), usb online=$(cat /sys/class/power_supply/tcpm-source-psy-*/online)"
[ "$(cat /sys/class/power_supply/tcpm-source-psy-*/online)" = 0 ] || out "WARNING: the phone is plugged in, the measurement includes charging"

# op8-thermal and the buttons stay out of the way while the marker exists (as in standby)
touch /run/op8-standby.active

measure "S0 screen on, Steam interface"

echo 0 > "$BL/brightness"
for c in "$U/app.slice" "$U/user.slice"; do echo 1 > "$c/cgroup.freeze"; done
for p in policy4 policy7; do cat "$CF/$p/cpuinfo_min_freq" > "$CF/$p/scaling_max_freq"; done
measure "S1 the current sleep (backlight 0, frozen)"

for c in "$U/app.slice" "$U/user.slice"; do echo 0 > "$c/cgroup.freeze"; done
sleep 1
gsctl drm_sleep_internal_screen 1
sleep 2
for c in "$U/app.slice" "$U/user.slice"; do echo 1 > "$c/cgroup.freeze"; done
measure "S2 + panel off (DPMS through gamescope)"

systemctl kill -s STOP op8-sampler
cat "$CF/policy0/cpuinfo_min_freq" > "$CF/policy0/scaling_max_freq"
measure "S3 + logger paused, little cores at minimum"

rfkill block bluetooth
measure "S4 + Bluetooth off"

rfkill block wlan
measure "S5 + WiFi off"

out "done $(date '+%T')"
