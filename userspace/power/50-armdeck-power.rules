// armdeck: the user gabriel (Steam runs in a container, with no session logged in on the screen)
// may suspend (here: op8-standby, not kernel suspend), power off and reboot the phone without a
// password, even while SSH sessions hold sleep inhibitors. Without this rule logind answers
// "challenge" and Steam stays stuck at "suspend operation in progress".
polkit.addRule(function(action, subject) {
	var ids = [
		"org.freedesktop.login1.suspend",
		"org.freedesktop.login1.suspend-multiple-sessions",
		"org.freedesktop.login1.suspend-ignore-inhibit",
		"org.freedesktop.login1.power-off",
		"org.freedesktop.login1.power-off-multiple-sessions",
		"org.freedesktop.login1.power-off-ignore-inhibit",
		"org.freedesktop.login1.reboot",
		"org.freedesktop.login1.reboot-multiple-sessions",
		"org.freedesktop.login1.reboot-ignore-inhibit"
	];
	if (subject.user == "gabriel" && ids.indexOf(action.id) >= 0) {
		return polkit.Result.YES;
	}
});
