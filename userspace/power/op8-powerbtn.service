[Unit]
Description=op8-powerbtn: the power button as on a Steam Deck (short = sleep, long = menu)

[Service]
# background.slice: op8-standby freezes only app.slice and user.slice
Slice=background.slice
ExecStart=/home/gabriel/op8-powerbtn
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
