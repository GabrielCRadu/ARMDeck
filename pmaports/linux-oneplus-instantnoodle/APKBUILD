# Reference: <https://postmarketos.org/vendorkernel>
# DRAFT. Runs on a real OnePlus 8 (IN2013) since 2026-10-01. Builds through the real
# abuild/pmbootstrap pipeline with LLVM/clang (ARCH=arm64 LLVM=1), the same
# convention as device/community/linux-postmarketos-qcom-sm8250. See
# docs/verification-log.md for the build history.
maintainer=""
_flavor="oneplus-instantnoodle"
pkgname=linux-$_flavor
pkgver=6.16.7
pkgrel=7
pkgdesc="OnePlus 8 (instantnoodle) mainline kernel, Xo666 fork"
arch="aarch64"
_carch="arm64"
_config="op8_defconfig"
url="https://github.com/Xo666/mainline-instantnoodle"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	clang
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
"

# Source: Xo666/mainline-instantnoodle, branch 6.16.7, head commit
# 408762bfe17332622560658f394f9cdbb1c9902e (2026-01-14, unchanged as of
# 2026-10-01). This is the tree the postmarketOS wiki reports as booting with
# working 3D, and the only one of the three forks with a complete zap-shader
# wiring for the GPU. The sha512sum below pins the exact tarball content.
#
# Kept as close to upstream Xo666 as possible. The patches only move
# hardware settings back toward what the OnePlus vendor kernel and the other
# OnePlus 8 device trees do (see each patch header):
#   0001: the speaker amplifiers' boost converter was programmed from
#         uninitialized stack variables.
#   0002: the camera PMIC rails for the unsupported rear cameras were forced
#         on from boot, one of them at 1.2 V where OnePlus runs 1.104 V.
#   0003: the board DTS deleted the removed_mem reservation (0x80b00000)
#         and never added it back, so Linux used about 210 MB of secure-world
#         memory as RAM. Once RAM filled up (big Steam downloads) the phone
#         reset instantly with nothing in the kernel log. Found and verified
#         on hardware on 2026-10-02; details in the patch header.
#   0004: the USB-C connector asked PD chargers for up to 12 V; the OnePlus 8
#         never used more than 5 V over PD on Android. 5 V only (tested with
#         a 45 W charger on 2026-10-02).
#
# steamed-noodle.config is merged over op8_defconfig: NTSYNC, preemption
# switchable at runtime (default full), MGLRU and the lockup detectors. See
# docs/compat-perf-audit.md.
#
# No charger driver: this tree has no driver for qcom,pm8150b-charger or
# qcom,pm8150b-fg (checked 2026-10-01), so charging is left to the PMIC
# hardware defaults set by the bootloader. An earlier patch here only added
# device tree nodes for those, which nothing ever bound to. It was removed.
# Do NOT port qcom_pm8150b_charger.c from WuerfelDev or the postmarketOS
# SM8250 kernel as-is: it programs PM8150B's float voltage with the PMI8998
# register scale, which on this battery means about 4.87 V instead of
# 4.435 V. See docs/hardware-safety.md.
source="
	$pkgname-$pkgver.tar.gz::https://github.com/Xo666/mainline-instantnoodle/archive/refs/heads/$pkgver.tar.gz
	0001-ASoC-tfa9872-fix-uninitialized-DC-DC-config.patch
	0002-arm64-dts-qcom-instantnoodle-match-PM8009-camera-rails-to-OEM.patch
	0003-arm64-dts-qcom-instantnoodle-restore-removed_mem-reservation.patch
	0004-arm64-dts-qcom-instantnoodle-limit-usb-c-sink-to-5V.patch
	steamed-noodle.config
"
builddir="$srcdir/mainline-instantnoodle-$pkgver"

prepare() {
	default_prepare
	make ARCH="$_carch" LLVM=1 "$_config"
	ARCH="$_carch" ./scripts/kconfig/merge_config.sh -m .config "$srcdir"/steamed-noodle.config
	make ARCH="$_carch" LLVM=1 olddefconfig
	# merge_config.sh only warns when a requested value does not stick
	local opt
	for opt in NTSYNC PREEMPT_DYNAMIC LRU_GEN SOFTLOCKUP_DETECTOR HARDLOCKUP_DETECTOR \
			DETECT_HUNG_TASK; do
		grep -q "^CONFIG_$opt=y" .config || die "CONFIG_$opt did not end up enabled"
	done
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$pkgrel-$_flavor" \
		Image.gz dtbs modules
}

package() {
	mkdir -p "$pkgdir"/boot

	make ARCH="$_carch" LLVM=1 \
		zinstall modules_install dtbs_install \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	# mkinitfs scans /usr/share/kernel/*/kernel.release to find installed
	# kernels - without this file it reports "found: []" and fails, even
	# though the actual vmlinuz/modules are present under boot/ and
	# lib/modules/. Missing from the first draft; found by diffing against
	# the working device/community/linux-postmarketos-qcom-sm8250 package
	# after a real `pmbootstrap install` failed with exactly that error.
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

