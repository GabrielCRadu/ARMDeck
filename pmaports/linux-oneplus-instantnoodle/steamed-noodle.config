# steamed-noodle: options merged over op8_defconfig in prepare().
# See docs/compat-perf-audit.md (P2, P3) and docs/performance-crash-audit.md.

# NT synchronization driver (/dev/ntsync); Proton 11 uses it on its own when
# the device exists. Built in, so no module loading is needed.
CONFIG_NTSYNC=y

# Full preemption by default, switchable at boot (preempt=none|voluntary|full)
# or at runtime through /sys/kernel/debug/sched/preempt, so the modes can be
# compared in games without another kernel build.
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

# Multi-generational LRU: better choice of pages to evict when RAM fills up
# (large downloads fill the page cache; Android uses it too).
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Lockup detectors: a stuck CPU or task now leaves a stack trace in the log
# instead of an unexplained reset. Warnings only, no panic.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_WQ_WATCHDOG=y
