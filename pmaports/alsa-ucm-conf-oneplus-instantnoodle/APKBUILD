# Reference: <https://postmarketos.org/devicepkg>
# DRAFT, builds through pmbootstrap, not yet tested on hardware. Sourced from
# github.com/Xo666/linux-oneplus-instantnoodle. The HiFi.conf mixer paths
# (TERT_MI2S_RX, WCD9380 RX/TX) reference the codec confirmed in
# reference/dts/sm8250-oneplus-instantnoodle.dts (qcom,wcd9380-codec).
#
# This package ships only two files (ucm2/OnePlus/OnePlus8.conf and
# HiFi.conf), so it must not "provide" alsa-ucm-conf: an earlier draft did,
# which lets apk treat the real alsa-ucm-conf (with ucm2/ucm.conf, the file
# that makes ALSA look up any card config at all) as already installed.
# pmaports CI also rejects an unversioned alsa-ucm-conf provider
# (.ci/testcases/test_provides.py). It depends on the real package instead.
#
# ALSA finds a card's UCM config through conf.d/<driver>/<card longname>.conf.
# The card here is driver "sm8250", longname "OnePlus8", so without the
# conf.d/sm8250/OnePlus8.conf link the files in ucm2/OnePlus/ are never
# loaded and PipeWire creates no output at all (found on hardware 2026-10-02).
#
# Speaker safety: HiFi.conf defines no hardware volume control for the two
# TFA9874 speaker amplifiers, and the kernel driver runs them without any
# speaker protection. Keep software volume moderate; see
# docs/hardware-safety.md and userspace/audio/ (PipeWire must open the PCM as
# S16LE without mmap: with S24LE or mmap the stream runs but the amps stay
# silent).
maintainer=""
pkgname=alsa-ucm-conf-oneplus-instantnoodle
pkgver=1
pkgrel=2
pkgdesc="ALSA UCM configuration for OnePlus 8 (instantnoodle)"
url="https://github.com/Xo666/linux-oneplus-instantnoodle"
arch="aarch64"
license="proprietary"
depends="alsa-ucm-conf"
options="!check"
_commit="9e645da0ce76ccb7594d5b2da6fb43fe374b6897"
source="$pkgname-$_commit.tar.gz::https://github.com/Xo666/linux-oneplus-instantnoodle/archive/$_commit.tar.gz"
builddir="$srcdir/linux-oneplus-instantnoodle-$_commit"

package() {
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2
	cp -r "$builddir/alsa-oneplus-instantnoodle/usr/share/alsa/ucm2/OnePlus" \
		"$pkgdir"/usr/share/alsa/ucm2/
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8250
	ln -s ../../OnePlus/OnePlus8.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8250/OnePlus8.conf
}

sha512sums="
8616aedad38a23f38ddb1ead7d56e252f66707930f93ea93563f4eaaba02a52f1d798a30d2c4ca29ed375d71322e5b6536c1cc028bf4083d436dace1f664fc68  alsa-ucm-conf-oneplus-instantnoodle-9e645da0ce76ccb7594d5b2da6fb43fe374b6897.tar.gz
"
