# Port GPU zap-shader wiring from Xo666, plus the charger/fuel-gauge node
# definitions those existing board-level overrides in this tree turned out
# to actually require
#
# CORRECTION (2026-10-01): the charger/fuel-gauge part of this patch only
# makes the device tree compile. This tree has no driver for
# qcom,pm8150b-charger or qcom,pm8150b-fg (no qcom_pm8150b_charger.c, no
# qcom_fg.c in drivers/power/supply), so those nodes bind to nothing and
# charging is NOT enabled by this patch. The text below that presents this
# tree as "GPU + charger + fuel gauge at once" is wrong on the charger half.
# Do not add the community qcom_pm8150b_charger.c driver to make them work:
# it programs about 4.87 V float voltage on this battery. See
# docs/hardware-safety.md.
#
# This tree (ObiKeahloa/linux, branch sm8250/v6.13-instantnoodle) is the
# only one of the three known instantnoodle forks whose board DTS carries
# both `&gpu { status = "okay"; }` and board-level `&pm8150b_charger` /
# `&pm8150b_fg` override blocks at once - see docs/verification-log.md
# section 1.4 in the steamos-android repo for the three-way fork comparison.
# Its documented blocker was that `&gpu` had no zap-shader child node at
# all, so the GPU's mandatory signed firmware (a650_zap.mbn) had nowhere to
# be declared - the project treats that wiring as a hard prerequisite for
# the Adreno 650 to initialize (see the firmware table in the main doc).
#
# What this patch actually does, in two parts:
#
# 1. Adds the zap-shader child node to `&gpu`, ported byte-for-byte from
#    Xo666/mainline-instantnoodle (branch 6.16.7, the tree audited locally
#    at reference/dts/sm8250-oneplus-instantnoodle.dts, lines 957-970) -
#    same `memory-region = <&gpu_mem>;` and
#    `firmware-name = "qcom/sm8250/OnePlus/a650_zap.mbn";` as Xo666 uses.
#    Checked first, before assuming it would resolve: the `gpu_mem`
#    reserved-memory node the zap-shader references already exists in
#    ObiKeahloa's own tree, at the identical address and size Xo666 uses
#    (`reg = <0x0 0x8e21a000 0x0 0x2000>;`, deleted from the upstream
#    sm8250.dtsi node of the same name and redefined at board level, same
#    pattern both trees use) - just under the unit name `memory@8e21a000`
#    instead of Xo666's `gpu@8e21a000`. The unit name is cosmetic; the
#    `gpu_mem:` label the zap-shader's phandle resolves against is
#    identical. No reserved-memory node needed to be added or ported.
#
# 2. Adds the `pm8150b_charger` (charger@1000) and `pm8150b_fg`
#    (fuel-gauge@4000) node definitions, plus the `channel@7`
#    (usb_in_i_uv) and `channel@8` (usb_in_v_div_16) ADC sub-nodes they
#    need, to this tree's own `pm8150b.dtsi`.
#
#    This second part was NOT in the original plan for this patch and is
#    the most important finding here. docs/verification-log.md's
#    fork-divergence table (section 1.4) described ObiKeahloa's charger/fg
#    support as "near-identical wiring to WuerfelDev... &pm8150b_fg also
#    'okay'" - true of the board DTS *text*, which does carry
#    `&pm8150b_fg { status = "okay"; ... };` and
#    `&pm8150b_charger { ... status = "okay"; };` override blocks. But that
#    assessment was made by reading the saved reference/dts/ snapshot, not
#    by compiling the actual kernel tree. Doing that here found the real
#    situation: ObiKeahloa's own `pm8150b.dtsi` in this branch never
#    defines the `pm8150b_charger` or `pm8150b_fg` labels those override
#    blocks target - `grep -rn 'pm8150b-charger\|pm8150b-fg'` across the
#    entire `arch/arm64/boot/dts/qcom/` directory of this clone returns
#    nothing. The board DTS overrides reference labels that simply do not
#    exist anywhere in this tree. Confirmed this is not a mistake
#    introduced by anything in this patch: `git stash`-ing this patch and
#    building the unmodified tree's `dtbs` target fails with the exact
#    same two errors -
#      Error: .../sm8250-oneplus-instantnoodle.dts:848.1-12 Label or path
#      pm8150b_fg not found
#      Error: .../sm8250-oneplus-instantnoodle.dts:854.1-17 Label or path
#      pm8150b_charger not found
#    i.e. ObiKeahloa's tree does not compile at HEAD at all, regardless of
#    this patch or the GPU question. That is a materially different,
#    more serious problem than "GPU works but charging needs testing" -
#    it means the charging half of the "closest match" framing in
#    verification-log.md was not actually buildable as shipped.
#
#    The fix ported here is structurally the same one already applied to
#    Xo666 in pmaports/linux-oneplus-instantnoodle/0001-port-charger-fg-from-wuerfeldev.patch:
#    ObiKeahloa's pm8150b.dtsi turned out to have the exact same
#    charger/fg-less shape Xo666's did (same channel@6/channel@9 ADC
#    layout, same missing charger@1000/fuel-gauge@4000 nodes), so the same
#    node content - originally sourced from WuerfelDev/linux-sm8250,
#    branch 6.17.0-instantnoodle - was inserted at the same relative
#    positions. ObiKeahloa's own board-level override blocks in
#    sm8250-oneplus-instantnoodle.dts (io-channels list including
#    channel@83 vph_pwr and channel@99 chg_sbux, which this tree's board
#    DTS already declared on `&pm8150b_adc` before this patch) were left
#    completely untouched - they were already correct, they just had
#    nothing to attach to.
#
# Nothing related to the SBU mux / USB-C orientation-switch wiring
# (`fcs,fsa4480`) is touched by this patch. It was already
# `status = "disabled"` in this tree before this patch (matching
# WuerfelDev, per verification-log.md section 1.4) and remains disabled
# after - confirmed by decompiling the built .dtb and checking that node
# directly, not assumed. This patch does not fix or claim to fix
# USB-C orientation switching.
#
# Source of the zap-shader content: reference/dts/sm8250-oneplus-instantnoodle.dts
# in the steamos-android repo (Xo666/mainline-instantnoodle, branch
# 6.16.7), read directly, not re-fetched. Source of the charger/fg node
# content: pmaports/linux-oneplus-instantnoodle/0001-port-charger-fg-from-wuerfeldev.patch
# in this same repo, which itself sourced it from WuerfelDev/linux-sm8250,
# branch 6.17.0-instantnoodle.
#
# Firmware path convention mismatch, flagged and NOT resolved by this
# patch: every other firmware-name property already present in
# ObiKeahloa's tree uses a lowercase, .mdt-suffixed path -
# "qcom/sm8250/oneplus/adsp.mdt", "cdsp.mdt", "slpi.mdt", "venus.mdt"
# (confirmed by grepping this clone). The zap-shader node ported here
# keeps Xo666's exact string instead - "qcom/sm8250/OnePlus/a650_zap.mbn",
# capital O, .mbn extension - to stay a faithful port of the one tree with
# demonstrated GPU firmware loading, rather than guessing at a renamed
# .mdt variant that has never been shown to work. This means a firmware
# package built for this tree cannot simply reuse the lowercase/.mdt
# layout its other four blobs expect; the zap shader blob needs to land at
# the differently-cased .mbn path instead. Whether the kernel's
# remoteproc/mdt loader would even accept an .mbn-suffixed file through
# the same `firmware-name` mechanism the other four .mdt blobs use is not
# verified here - this is a real open question for anyone packaging
# firmware for this specific combination, not a solved problem.
#
# Status: compile-verified only, on both counts. Verified 2026-08-24:
#   - `make ARCH=arm64 LLVM=1 defconfig` (this tree's defconfig is named
#     plainly "defconfig" in arch/arm64/configs/, not an op8-specific name
#     - there is no op8_defconfig or similar in this tree, unlike Xo666)
#     configured cleanly.
#   - `make ARCH=arm64 LLVM=1 -j16 dtbs` completed with exit code 0 and
#     zero warnings or errors anywhere in the build log, sm8250-oneplus-instantnoodle.dtb
#     included specifically (grepped the whole log for
#     "warning"/"error" - none attached to this target).
#   - Decompiled the resulting .dtb (`dtc -I dtb -O dts`) and confirmed all
#     three node types resolve fully with status = "okay": the
#     `zap-shader` node under `&gpu` (memory-region phandle resolves to
#     the gpu_mem reserved-memory node at 0x8e21a000, firmware-name
#     string present); `charger@1000` (all 5 io-channels correctly
#     cross-referenced: usb_in_i_uv, usb_in_v_div_16, chg_sbux, vph_pwr,
#     chg_temp, plus monitored-battery phandle resolved); and
#     `fuel-gauge@4000` (monitored-battery and power-supplies phandles
#     both resolved, the latter pointing back at the charger node).
#   - This has NOT been tested on real hardware. It is not known whether
#     the GPU actually initializes with this firmware path on this
#     specific kernel's remoteproc/a6xx driver stack, whether the charger
#     or fuel-gauge drivers actually probe against real silicon, or
#     whether stacking all three changes together has any runtime
#     interaction a static DTS/DTB diff cannot show. Same caveats as
#     pmaports/linux-oneplus-instantnoodle/0001-port-charger-fg-from-wuerfeldev.patch,
#     which this patch's second part otherwise mirrors - see
#     docs/verification-log.md for the full discussion.
#
diff --git a/arch/arm64/boot/dts/qcom/pm8150b.dtsi b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
index 3f7b0b6a1..4e9778c35 100644
--- a/arch/arm64/boot/dts/qcom/pm8150b.dtsi
+++ b/arch/arm64/boot/dts/qcom/pm8150b.dtsi
@@ -107,6 +107,26 @@ pm8150b_temp: temp-alarm@2400 {
 			#thermal-sensor-cells = <0>;
 		};

+		pm8150b_charger: charger@1000 {
+			compatible = "qcom,pm8150b-charger";
+			reg = <0x1000>;
+
+			interrupts = <0x2 0x13 0x4 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x12 0x2 IRQ_TYPE_EDGE_BOTH>,
+				     <0x2 0x16 0x1 IRQ_TYPE_EDGE_RISING>,
+				     <0x2 0x13 0x7 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "usbin-plugin",
+					  "bat-ov",
+					  "wdog-bark",
+					  "usbin-icl-change";
+
+			io-channels = <&pm8150b_adc 7>,
+				      <&pm8150b_adc 8>;
+			io-channel-names = "usb_in_i_uv", "usb_in_v_div_16";
+
+			status = "disabled";
+		};
+
 		pm8150b_adc: adc@3100 {
 			compatible = "qcom,spmi-adc5";
 			reg = <0x3100>;
@@ -133,6 +153,18 @@ channel@6 {
 				label = "die_temp";
 			};

+			channel@7 {
+				reg = <ADC5_USB_IN_I>;
+				qcom,pre-scaling = <1 1>;
+				label = "usb_in_i_uv";
+			};
+
+			channel@8 {
+				reg = <ADC5_USB_IN_V_16>;
+				qcom,pre-scaling = <1 16>;
+				label = "usb_in_v_div_16";
+			};
+
 			channel@9 {
 				reg = <ADC5_CHG_TEMP>;
 				qcom,pre-scaling = <1 1>;
@@ -150,6 +182,14 @@ pm8150b_adc_tm: adc-tm@3500 {
 			status = "disabled";
 		};

+		pm8150b_fg: fuel-gauge@4000 {
+			compatible = "qcom,pm8150b-fg";
+			reg = <0x4000>;
+			interrupts = <0x2 0x40 0x3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "soc-delta";
+			status = "disabled";
+		};
+
 		pm8150b_gpios: gpio@c000 {
 			compatible = "qcom,pm8150b-gpio", "qcom,spmi-gpio";
 			reg = <0xc000>;
diff --git a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
index 2873a4dae..b55bcc160 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-oneplus-instantnoodle.dts
@@ -609,6 +609,11 @@ &gmu {

 &gpu {
 	status = "okay";
+
+	zap-shader {
+		memory-region = <&gpu_mem>;
+		firmware-name = "qcom/sm8250/OnePlus/a650_zap.mbn";
+	};
 };

 &gpi_dma0 {
