# Reference: <https://postmarketos.org/devicepkg>
# DRAFT. First booted on a real OnePlus 8 (IN2013) on 2026-10-01 with
# linux-oneplus-instantnoodle r5. Adapted from device-oneplus-instantnoodlep
# (pmaports, packaged). See docs/verification-log.md for the sourcing and
# cross-checks behind every value here.
maintainer=""
pkgname=device-oneplus-instantnoodle
pkgdesc="OnePlus 8"
pkgver=0.1
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# The firmware lives in subpackages of firmware-oneplus-instantnoodle; its
# main package is empty, and apk never installs subpackages on its own. An
# earlier draft depended only on the empty main package, so the rootfs got
# no GPU zap shader, no DSP firmware and no WiFi firmware at all.
# slpi (sensor DSP) is left out on purpose: sensors do not work on any of
# the kernels yet, so there is no reason to start that DSP.
# linux-firmware-qca: QCA6390 Bluetooth firmware (qca/htbtfw20.tlv,
# qca/htnv20.bin) from official linux-firmware. Without it the first boot
# logged "QCA Failed to request file: qca/htbtfw20.tlv".
# qbootctl: marks the booted A/B slot successful on every boot (with
# qbootctl-systemd, pulled in by install_if, it runs "qbootctl -m" at
# multi-user.target). Without it the bootloader decrements the slot's retry
# count on each boot; after about 7 boots slot b became unbootable and the
# phone stopped at "the current image (boot/recovery) have been destroyed"
# (2026-10-02, fixed with fastboot --set-active=b). The packaged OnePlus 6
# port gets the same tool through soc-qcom-qbootctl.
depends="
	alsa-ucm-conf-oneplus-instantnoodle
	firmware-oneplus-instantnoodle-adsp
	firmware-oneplus-instantnoodle-cdsp
	firmware-oneplus-instantnoodle-gpu
	firmware-oneplus-instantnoodle-venus
	firmware-oneplus-instantnoodle-wifi
	linux-firmware-qca
	linux-oneplus-instantnoodle
	mkbootimg
	postmarketos-base
	qbootctl
"
makedepends="
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	kernel-cmdline.conf
	sm8250-oneplus-instantnoodle-empty.dts
"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-instantnoodle-empty.dts"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

