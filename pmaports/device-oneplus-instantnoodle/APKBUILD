# Reference: <https://postmarketos.org/devicepkg>
# DRAFT, not yet booted on hardware. Adapted from device-oneplus-instantnoodlep
# (pmaports, packaged). See docs/verification-log.md for the sourcing and
# cross-checks behind every value here.
maintainer=""
pkgname=device-oneplus-instantnoodle
pkgdesc="OnePlus 8"
pkgver=0.1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# The firmware lives in subpackages of firmware-oneplus-instantnoodle; its
# main package is empty, and apk never installs subpackages on its own. An
# earlier draft depended only on the empty main package, so the rootfs got
# no GPU zap shader, no DSP firmware and no WiFi firmware at all.
# slpi (sensor DSP) is left out on purpose: sensors do not work on any of
# the kernels yet, so there is no reason to start that DSP.
depends="
	alsa-ucm-conf-oneplus-instantnoodle
	firmware-oneplus-instantnoodle-adsp
	firmware-oneplus-instantnoodle-cdsp
	firmware-oneplus-instantnoodle-gpu
	firmware-oneplus-instantnoodle-venus
	firmware-oneplus-instantnoodle-wifi
	linux-oneplus-instantnoodle
	mkbootimg
	postmarketos-base
"
makedepends="
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	kernel-cmdline.conf
	sm8250-oneplus-instantnoodle-empty.dts
"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo.img" -I dts "$srcdir/sm8250-oneplus-instantnoodle-empty.dts"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

