# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
#
# DRAFT, not verified on hardware. Adapted from the packaged
# device-oneplus-instantnoodlep (OnePlus 8 Pro) port, since the two devices
# share the same SM8250 platform, generation, and ABL bootloader. The flash
# offsets match instantnoodlep and the 8T (kebab) port exactly. Screen
# resolution and codename are corrected for the non-Pro model.
#
# Notes from the 2026-10-01 audit (details in docs/verification-log.md):
# - The rootfs image is written raw over the whole "super" partition
#   (/dev/sda14 on this phone, per the postmarketOS wiki partition dump).
#   That destroys Android's system/vendor/product. Back up super first; see
#   docs/hardware-safety.md.
# - deviceinfo_super_partitions was removed. It is not read by pmbootstrap,
#   but it IS read by the postmarketOS initramfs on the phone
#   (init_2nd.sh: setup_dynamic_partitions), which tries to map Android
#   logical partitions inside the listed partitions. With the rootfs written
#   raw over super there are no logical partitions to map, so the field had
#   nothing to do here.
# - deviceinfo_flash_fastboot_partition_vbmeta only makes pmbootstrap offer
#   "pmbootstrap flasher flash_vbmeta". The official 8 Pro and 8T ports do
#   not set it and boot fine with an unlocked bootloader, so that step is
#   optional: use it only if the bootloader refuses the boot image.

deviceinfo_format_version="0"
deviceinfo_name="OnePlus 8"
deviceinfo_manufacturer="OnePlus"
deviceinfo_codename="oneplus-instantnoodle"
deviceinfo_year="2020"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_header_version="2"
deviceinfo_dtb="qcom/sm8250-oneplus-instantnoodle"
deviceinfo_flash_offset_dtb="0x01f00000"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x00000100"
deviceinfo_flash_fastboot_partition_rootfs="super"
deviceinfo_flash_fastboot_partition_dtbo="dtbo"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
deviceinfo_rootfs_image_sector_size="4096"
deviceinfo_flash_sparse="true"
